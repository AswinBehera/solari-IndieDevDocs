{
  "name": "doen-thang",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "pnpm db:up && turbo run dev",
    "typecheck": "tsc -p tools/tsconfig.json && turbo run typecheck",
    "test": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && turbo run check:seam test:tools && pnpm test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @dt/db db:generate",
    "db:migrate": "pnpm --filter @dt/db db:migrate",
    "db:migrate:hosted": "./tools/with-hosted-env.sh pnpm --filter @dt/db db:migrate",
    "db:seed": "pnpm --filter @dt/db db:seed",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "check:seam": "tsx tools/check-seam.ts",
    "test:tools": "vitest run --dir tools"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.20.2",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "tsx": "^4.20.6"
  }
}
