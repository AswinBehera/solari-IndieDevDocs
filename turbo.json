{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      // Turbo 2 runs tasks in strict env mode: a variable not named here is not
      // visible to the task, whatever the shell exported. Without this line
      // `DATABASE_URL` never reaches vitest, the 13 Postgres tests skip themselves,
      // and the run still reports green — which is exactly how CI would have
      // claimed to test the one component with real concurrency in it.
      //
      // P0.8 found the layer above this one leaking the same way: turbo passes the
      // variable through, but nothing put it in turbo's own environment, because
      // nothing loads `.env`. The root `test` script does that now. `SAMSARA_NO_DB`
      // is the declared opt-out — see `jobs.pg.test.ts`.
      "env": ["DATABASE_URL", "SOLARI_LIVE", "SAMSARA_NO_DB"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": []
    }
  }
}
