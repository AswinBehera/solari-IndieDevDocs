{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // A component library for the browser: DOM and JSX, and deliberately no Node
    // types — `@dt/ui` renders, it does not read a file or an environment
    // variable, and a stray `process.env` here should fail to compile rather
    // than ship to a bundle.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
