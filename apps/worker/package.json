{
  "name": "@dt/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start": "tsx src/index.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/dev.ts",
    "record:plan": "tsx --env-file-if-exists=../../.env src/record-capture.ts --dry-run",
    "record": "tsx --env-file-if-exists=../../.env src/record-capture.ts"
  },
  "dependencies": {
    "@dt/db": "workspace:*",
    "@dt/travel-pack": "workspace:*",
    "@samsara/core": "workspace:*",
    "@samsara/harvest": "workspace:*",
    "@samsara/kernel": "workspace:*",
    "@samsara/llm": "workspace:*",
    "@samsara/personas": "workspace:*",
    "@samsara/refine": "workspace:*",
    "@samsara/sources": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.1"
  }
}
