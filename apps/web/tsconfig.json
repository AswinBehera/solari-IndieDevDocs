{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The browser, so: DOM, JSX, and Vite's client types for `import.meta.env` and
    // the CSS import. Deliberately no Node types — this code ships to a browser, and
    // a stray `process.env` should not compile.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src"]
}
