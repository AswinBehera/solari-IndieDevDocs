{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The browser, so: DOM, JSX, and Vite's client types for `import.meta.env` and
    // the CSS import. Deliberately no Node types — this code ships to a browser, and
    // a stray `process.env` should not compile.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src"],
  // The travel app this repo started as, left on disk until it is deleted by hand.
  // Nothing imports it, and it no longer has its packages to compile against.
  "exclude": ["src/trip", "src/trips", "src/places", "src/lab", "src/samsara", "src/share", "src/onboarding", "src/kernel"]
}
