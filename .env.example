# Copy to .env and fill in. .env is gitignored; never commit a real key.

# --- Solari (cloud browsers, sandboxes, desktops) ---
# One slr_live_ key covers all three products. console.getsolari.com
SOLARI_API_KEY=

# --- LLM (ADR-0012: OpenRouter is the gateway; the model is config, not code) ---
# openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model ids per task. A call to an unset task refuses by name rather than falling
# back to a default — a default here is how a model nobody measured reaches
# production. Check current rates at openrouter.ai/models before setting these.
#
# EXTRACT was measured on 18 September 2026 by `tools/bake-off.ts` against the 50
# hand-labelled Thai items, on five routes for $0.16 all in:
#
#   deepseek/deepseek-v4-flash        86.5%  prec 88.9%  invented 3  $0.0092
#   anthropic/claude-haiku-4.5 (ref)  86.5%  prec 92.8%  invented 1  $0.1028
#   qwen/qwen3-30b-a3b-instruct-2507  78.4%  prec 69.0%  invented 5  $0.0235
#   qwen/qwen3.7-flash                73.0%  prec 80.6%  invented 2  $0.0159
#   google/gemini-2.5-flash-lite      71.6%  prec 76.8%  invented 6  $0.0076
#
# DeepSeek is the only candidate clearing the 80% recall bar, and it ties the
# frontier reference on recall exactly at a ninth of the price. Haiku is better
# where it is better — precision and invented names — and that gap is what the
# cheap route costs. Not a `:free` route, so ADR-0012's retention terms do not
# apply. Re-run the bake-off before changing this; the rates above are stale the
# day they were written.
LLM_MODEL_EXTRACT=deepseek/deepseek-v4-flash
# Still unmeasured: no summarise prompt exists to measure one against.
LLM_MODEL_SUMMARISE=
# How the response is asked for: schema | json | none. `schema` sends the caller's
# Zod schema as json_schema. A route that rejects it fails as `config`, naming this
# variable; `json` is the fallback. Validation happens above regardless (ADR-0012).
LLM_RESPONSE_FORMAT=schema
# Optional attribution on openrouter.ai. Neither is a secret; both are omitted
# rather than sent empty when unset.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=

# --- Budget ceilings (section 8). Counts, not dollars: rates drift, counts do not. ---
BUDGET_SOLARI_MINUTES=4000
BUDGET_LLM_INPUT_TOKENS=20000000
BUDGET_LLM_OUTPUT_TOKENS=4000000
BUDGET_GEOCODE_CALLS=800
# Lifetime cap (never resets), counted from when the counter began; default 8000 (~$16).
BUDGET_SOLARI_MINUTES_TOTAL=8000

# --- Data ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/doen_thang
# No REDIS_URL: ADR-0014 removed Redis. Job queue and budget counters are Postgres tables.

# --- Supabase (ADR-0005 storage + Postgres, ADR-0013 auth) ---
# Two keys, and mixing them up is the standard way to leak a Supabase database.
SUPABASE_URL=
# anon: safe in the browser. apps/web only.
SUPABASE_ANON_KEY=
# service role: bypasses every policy. apps/api and apps/worker only. NEVER shipped to a client.
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub Actions (ADR-0014 runner, ADR-0016 foreground dispatch) ---
# Set on the Worker with `wrangler secret put` / `[vars]`, not read from this file
# in production. Listed here so the shape of a working deployment is one file.
# Fine-grained token: `actions:write` on this repository and nothing else. The
# repository is public — this token must never be logged.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_WORKFLOW=worker.yml
GITHUB_REF=main

# --- Worker run shape (ADR-0014). Every one has a default in code. ---
# Budget is deliberately under the Actions grace period, so a cancelled run has
# time to close browser sessions and hand its claims back.
WORKER_BUDGET_MS=240000
WORKER_LEASE_MS=300000
WORKER_BATCH_SIZE=1

# Optional: Jev (TypeSafe System One) page judge for price probes. Unset = regex only.
TYPESAFE_API_KEY=
